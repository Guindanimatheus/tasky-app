                </KeyedProperty>
            </KeyedObject>

            <!-- Orelhas fora de compasso uma com a outra, senao viram
                 antena de carro. -->
            <KeyedObject objectId="0:22" id="0:140">
                <KeyedProperty property="rotation" id="0:141">
                    <KeyFrameDouble value="0" interpolationType="cubic" id="0:142"/>
                    <KeyFrameDouble value="-0.035" interpolationType="cubic" frame="50" id="0:143"/>
                    <KeyFrameDouble value="0.02" interpolationType="cubic" frame="120" id="0:144"/>
                    <KeyFrameDouble value="0" interpolationType="cubic" frame="180" id="0:145"/>
                </KeyedProperty>
            </KeyedObject>

            <KeyedObject objectId="0:23" id="0:146">
                <KeyedProperty property="rotation" id="0:147">
                    <KeyFrameDouble value="0" interpolationType="cubic" id="0:148"/>
                    <KeyFrameDouble value="0.03" interpolationType="cubic" frame="62" id="0:149"/>
                    <KeyFrameDouble value="-0.022" interpolationType="cubic" frame="130" id="0:150"/>
                    <KeyFrameDouble value="0" interpolationType="cubic" frame="180" id="0:151"/>
