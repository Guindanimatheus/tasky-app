            </KeyedObject>

            <KeyedObject objectId="0:35" id="0:152">
                <KeyedProperty property="rotation" id="0:153">
                    <KeyFrameDouble value="0" interpolationType="cubic" id="0:154"/>
                    <KeyFrameDouble value="-0.13" interpolationType="cubic" frame="45" id="0:155"/>
