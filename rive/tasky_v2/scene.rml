                </KeyedProperty>
                <KeyedProperty property="rotation" id="0:135">
                    <KeyFrameDouble value="0" interpolationType="cubic" id="0:136"/>
                    <KeyFrameDouble value="0.011" interpolationType="cubic" frame="60" id="0:137"/>
                    <KeyFrameDouble value="-0.009" interpolationType="cubic" frame="125" id="0:138"/>
