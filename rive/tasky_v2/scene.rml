                    <KeyFrameDouble value="0" interpolationType="cubic" frame="180" id="0:165"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Piscada. 5s em loop, fora do compasso da respiracao, com duas
             piscadas em tempos diferentes para nao soar mecanico. -->
        <LinearAnimation loopValue="loop" duration="300" name="Piscar" id="0:51">
            <KeyedObject objectId="0:20" id="0:166">
                <KeyedProperty property="opacity" id="0:167">
                    <KeyFrameDouble value="0" interpolationType="hold" id="0:168"/>
                    <KeyFrameDouble value="1" interpolationType="hold" frame="40" id="0:169"/>
                    <KeyFrameDouble value="0" interpolationType="hold" frame="46" id="0:170"/>
                    <KeyFrameDouble value="1" interpolationType="hold" frame="208" id="0:171"/>
