        <!-- Respiracao, microbalanco da cabeca, tremida das orelhas e
             balanco da cauda. 3s em loop. -->
        <LinearAnimation loopValue="loop" duration="180" name="Respirar" id="0:50">
            <KeyedObject objectId="0:28" id="0:117">
                <KeyedProperty property="scaleY" id="0:118">
                    <KeyFrameDouble value="1" interpolationType="cubic" id="0:119"/>
                    <KeyFrameDouble value="1.018" interpolationType="cubic" frame="90" id="0:120"/>
