                    <KeyFrameDouble value="1.08" interpolationType="cubic" frame="6" id="0:199"/>
                    <KeyFrameDouble value="0.94" interpolationType="cubic" frame="15" id="0:200"/>
                    <KeyFrameDouble value="0.97" interpolationType="cubic" frame="21" id="0:201"/>
                    <KeyFrameDouble value="1.09" interpolationType="cubic" frame="28" id="0:202"/>
                    <KeyFrameDouble value="0.98" interpolationType="cubic" frame="34" id="0:203"/>
                    <KeyFrameDouble value="1" interpolationType="cubic" frame="40" id="0:204"/>
                </KeyedProperty>
