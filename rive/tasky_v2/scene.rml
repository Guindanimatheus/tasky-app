                    <KeyFrameDouble value="0" interpolationType="cubic" frame="180" id="0:158"/>
                </KeyedProperty>
            </KeyedObject>

            <!-- A ponta atrasa 15 quadros em relacao a base: e isso que da
                 o chicote. -->
            <KeyedObject objectId="0:36" id="0:159">
                <KeyedProperty property="rotation" id="0:160">
                    <KeyFrameDouble value="0" interpolationType="cubic" id="0:161"/>
                    <KeyFrameDouble value="-0.10" interpolationType="cubic" frame="60" id="0:162"/>
                    <KeyFrameDouble value="0" interpolationType="cubic" frame="105" id="0:163"/>
