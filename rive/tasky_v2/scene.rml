                    <KeyFrameDouble value="0" interpolationType="cubic" frame="40" id="0:211"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Estado de repouso da camada "reacao": nao mexe em nada. -->
        <LinearAnimation duration="1" name="Parado" id="0:53"/>

        <!-- Interruptores de rosto: um quadro so, so opacidade do grupo. -->
        <LinearAnimation duration="1" name="Rosto0Nao" id="0:330">
