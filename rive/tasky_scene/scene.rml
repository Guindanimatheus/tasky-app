                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="3.5"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>

                <AnimationState x="420" y="20" animationId="0:79" id="0:58">
                    <StateTransition stateToId="0:57" duration="0">
                        <TransitionViewModelCondition opValue="lessThan">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyNumber>
                                    <DataBindContext sourcePathIds="0:40-0:45" propertyKey="636"/>
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="2.5"/>
