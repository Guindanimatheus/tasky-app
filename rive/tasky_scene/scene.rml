                                     enableExitTime="true" exitTimeIsPercetange="true"
                                     exitTime="100"/>
                </AnimationState>
            </StateMachineLayer>
        </StateMachine>

        <!-- Respiracao, balanco da cauda e microbalanco da cabeca. 3s em loop. -->
        <LinearAnimation loopValue="loop" duration="180" name="Respirar" id="0:70">
            <KeyedObject objectId="0:16">
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="1" interpolationType="cubic"/>
                    <KeyFrameDouble value="1.016" interpolationType="cubic" frame="90"/>
                    <KeyFrameDouble value="1" interpolationType="cubic" frame="180"/>
                </KeyedProperty>
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble value="1" interpolationType="cubic"/>
                    <KeyFrameDouble value="0.993" interpolationType="cubic" frame="90"/>
                    <KeyFrameDouble value="1" interpolationType="cubic" frame="180"/>
                </KeyedProperty>
                <KeyedProperty property="y">
                    <KeyFrameDouble value="0" interpolationType="cubic"/>
                    <KeyFrameDouble value="-3" interpolationType="cubic" frame="90"/>
                    <KeyFrameDouble value="0" interpolationType="cubic" frame="180"/>
                </KeyedProperty>
            </KeyedObject>

            <KeyedObject objectId="0:14">
                <KeyedProperty property="y">
                    <KeyFrameDouble value="0" interpolationType="cubic"/>
                    <KeyFrameDouble value="-2.5" interpolationType="cubic" frame="90"/>
                    <KeyFrameDouble value="0" interpolationType="cubic" frame="180"/>
                </KeyedProperty>
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="0" interpolationType="cubic"/>
                    <KeyFrameDouble value="0.011" interpolationType="cubic" frame="60"/>
                    <KeyFrameDouble value="-0.009" interpolationType="cubic" frame="125"/>
                    <KeyFrameDouble value="0" interpolationType="cubic" frame="180"/>
                </KeyedProperty>
            </KeyedObject>

            <KeyedObject objectId="0:20">
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="0" interpolationType="cubic"/>
                    <KeyFrameDouble value="-0.13" interpolationType="cubic" frame="45"/>
                    <KeyFrameDouble value="0" interpolationType="cubic" frame="90"/>
                    <KeyFrameDouble value="0.09" interpolationType="cubic" frame="135"/>
                    <KeyFrameDouble value="0" interpolationType="cubic" frame="180"/>
                </KeyedProperty>
            </KeyedObject>

            <!-- Pulso da aura. Vai junto da respiracao em vez de ganhar
                 camada propria: so o "aura-pulso" e tocado aqui, e ele nao
                 disputa nada com ninguem. Fora de fase com o peito, para a
                 energia nao parecer presa ao folego. -->
            <KeyedObject objectId="0:84">
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble value="0.97" interpolationType="cubic"/>
                    <KeyFrameDouble value="1.05" interpolationType="cubic" frame="70"/>
                    <KeyFrameDouble value="0.99" interpolationType="cubic" frame="130"/>
                    <KeyFrameDouble value="0.97" interpolationType="cubic" frame="180"/>
                </KeyedProperty>
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="0.97" interpolationType="cubic"/>
                    <KeyFrameDouble value="1.05" interpolationType="cubic" frame="70"/>
                    <KeyFrameDouble value="0.99" interpolationType="cubic" frame="130"/>
                    <KeyFrameDouble value="0.97" interpolationType="cubic" frame="180"/>
                </KeyedProperty>
                <KeyedProperty property="opacity">
                    <KeyFrameDouble value="0.72" interpolationType="cubic"/>
                    <KeyFrameDouble value="1" interpolationType="cubic" frame="70"/>
                    <KeyFrameDouble value="0.82" interpolationType="cubic" frame="130"/>
                    <KeyFrameDouble value="0.72" interpolationType="cubic" frame="180"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Piscada. 5s em loop, fora do compasso da respiracao, com duas
             piscadas em tempos diferentes para nao soar mecanico. -->
        <LinearAnimation loopValue="loop" duration="300" name="Piscar" id="0:73">
            <KeyedObject objectId="0:24">
                <KeyedProperty property="opacity">
                    <KeyFrameDouble value="0" interpolationType="hold"/>
                    <KeyFrameDouble value="1" interpolationType="hold" frame="40"/>
                    <KeyFrameDouble value="0" interpolationType="hold" frame="46"/>
                    <KeyFrameDouble value="1" interpolationType="hold" frame="208"/>
                    <KeyFrameDouble value="0" interpolationType="hold" frame="213"/>
                </KeyedProperty>
            </KeyedObject>

            <KeyedObject objectId="0:25">
                <KeyedProperty property="opacity">
                    <KeyFrameDouble value="0" interpolationType="hold"/>
                    <KeyFrameDouble value="1" interpolationType="hold" frame="40"/>
                    <KeyFrameDouble value="0" interpolationType="hold" frame="46"/>
                    <KeyFrameDouble value="1" interpolationType="hold" frame="208"/>
                    <KeyFrameDouble value="0" interpolationType="hold" frame="213"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Reacao ao toque: agacha, pula, estica no ar e amortece na
             aterrissagem. A cauda da um tranco no impulso. 0,67s. -->
        <LinearAnimation duration="40" name="Reagir" id="0:71">
            <KeyedObject objectId="0:23">
                <KeyedProperty property="y">
                    <KeyFrameDouble value="0" interpolationType="cubic"/>
                    <KeyFrameDouble value="3" interpolationType="cubic" frame="6"/>
                    <KeyFrameDouble value="-26" interpolationType="cubic" frame="15"/>
                    <KeyFrameDouble value="-29" interpolationType="cubic" frame="21"/>
                    <KeyFrameDouble value="0" interpolationType="cubic" frame="28"/>
                    <KeyFrameDouble value="0" interpolationType="cubic" frame="40"/>
                </KeyedProperty>
            </KeyedObject>

            <KeyedObject objectId="0:11">
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="1" interpolationType="cubic"/>
                    <KeyFrameDouble value="0.90" interpolationType="cubic" frame="6"/>
                    <KeyFrameDouble value="1.09" interpolationType="cubic" frame="15"/>
                    <KeyFrameDouble value="1.04" interpolationType="cubic" frame="21"/>
                    <KeyFrameDouble value="0.91" interpolationType="cubic" frame="28"/>
                    <KeyFrameDouble value="1.03" interpolationType="cubic" frame="34"/>
                    <KeyFrameDouble value="1" interpolationType="cubic" frame="40"/>
                </KeyedProperty>
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble value="1" interpolationType="cubic"/>
                    <KeyFrameDouble value="1.08" interpolationType="cubic" frame="6"/>
                    <KeyFrameDouble value="0.94" interpolationType="cubic" frame="15"/>
                    <KeyFrameDouble value="0.97" interpolationType="cubic" frame="21"/>
                    <KeyFrameDouble value="1.09" interpolationType="cubic" frame="28"/>
                    <KeyFrameDouble value="0.98" interpolationType="cubic" frame="34"/>
                    <KeyFrameDouble value="1" interpolationType="cubic" frame="40"/>
                </KeyedProperty>
            </KeyedObject>

            <KeyedObject objectId="0:19">
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="0" interpolationType="cubic"/>
                    <KeyFrameDouble value="-0.42" interpolationType="cubic" frame="10"/>
                    <KeyFrameDouble value="0.18" interpolationType="cubic" frame="22"/>
                    <KeyFrameDouble value="-0.06" interpolationType="cubic" frame="31"/>
                    <KeyFrameDouble value="0" interpolationType="cubic" frame="40"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Interruptores dos semblantes. Um quadro so.
             "Nao" mexe so na opacidade; "Sim" tambem ajusta a postura. -->
        <LinearAnimation duration="1" name="MuitoDesanimadoNao" id="0:74">
            <KeyedObject objectId="0:26">
                <KeyedProperty property="opacity">
                    <KeyFrameDouble value="0" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <LinearAnimation duration="1" name="MuitoDesanimadoSim" id="0:75">
            <KeyedObject objectId="0:26">
                <KeyedProperty property="opacity">
                    <KeyFrameDouble value="1" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <!-- Postura encurvada. Num retrato de frente nao da para dobrar a
                 coluna para a frente, entao o encurvamento vem de tres sinais
                 que aparecem de frente: o conjunto afunda, o tronco comprime e
                 FECHA os ombros, e a cabeca despenca para dentro deles,
                 sumindo com o pescoco. -->
            <KeyedObject objectId="0:28">
                <KeyedProperty property="y">
                    <KeyFrameDouble value="20" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:39">
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="0.88" interpolationType="hold"/>
                </KeyedProperty>
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble value="0.96" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:29">
                <KeyedProperty property="y">
                    <KeyFrameDouble value="50" interpolationType="hold"/>
                </KeyedProperty>
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="0.03" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <!-- Tronco envergado: gira pelo quadril, com as pernas plantadas.
                 NEGATIVO leva o peito para a ESQUERDA de quem olha, que e o
                 lado pedido. Verificado por teste: +0,25 jogava o peito para
                 a direita, o oposto. -->
            <KeyedObject objectId="0:59">
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="-0.30" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <!-- Rabo bem mais baixo e recolhido. -->
            <KeyedObject objectId="0:47">
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="0.32" interpolationType="hold"/>
                </KeyedProperty>
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble value="0.70" interpolationType="hold"/>
                </KeyedProperty>
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="0.70" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <!-- Aura vermelha (TaskyColors.vermelho). -->
            <KeyedObject objectId="0:92">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="4DE83834" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:93">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="00E83834" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:94">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="3BE83834" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:95">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="1CE83834" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:96">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="00E83834" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Todos os humores tem aura agora, entao ela fica sempre visivel e
             o que muda e a COR. Nenhum estado "Nao" toca a aura: como as
             faixas cobrem toda a escala, sempre ha exatamente um "Sim"
             ligado, e um "Nao" declarado depois dele apagaria o trabalho
             dele. Por isso este aqui esta vazio de proposito. -->
        <LinearAnimation duration="1" name="MuitoAlegreNao" id="0:86"/>

        <!-- O mood 2 nao tem remendo de rosto (e a arte base), mas agora tem
             aura, entao ganhou camada so para colori-la. -->
        <LinearAnimation duration="1" name="NeutroNao" id="0:98"/>

        <LinearAnimation duration="1" name="NeutroSim" id="0:97">
            <!-- Aura amarela (TaskyColors.amarelo). -->
            <KeyedObject objectId="0:92">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="4DFFCC00" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:93">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="00FFCC00" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:94">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="3BFFCC00" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:95">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="1CFFCC00" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:96">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="00FFCC00" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <LinearAnimation duration="1" name="MuitoAlegreSim" id="0:87">
            <!-- Rabo maior ainda que o do mood 3 (1,42) e mais alto: e o topo
                 da escala. Mesmo no que todos os outros humores usam. -->
            <KeyedObject objectId="0:47">
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="-0.14" interpolationType="hold"/>
                </KeyedProperty>
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble value="1.70" interpolationType="hold"/>
                </KeyedProperty>
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="1.70" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:92">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="4D9B6BE0" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:93">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="009B6BE0" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:94">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="3B9B6BE0" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:95">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="1C9B6BE0" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:96">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="009B6BE0" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <LinearAnimation duration="1" name="AlegreNao" id="0:78">
            <KeyedObject objectId="0:55">
                <KeyedProperty property="opacity">
                    <KeyFrameDouble value="0" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <LinearAnimation duration="1" name="AlegreSim" id="0:79">
            <KeyedObject objectId="0:55">
                <KeyedProperty property="opacity">
                    <KeyFrameDouble value="1" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <!-- Rabo maior que o normal e um pouco mais alto. Mesmo no que os
                 humores baixos encolhem: as faixas nao se sobrepoem. -->
            <KeyedObject objectId="0:47">
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="-0.06" interpolationType="hold"/>
                </KeyedProperty>
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble value="1.42" interpolationType="hold"/>
                </KeyedProperty>
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="1.42" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <!-- Aura verde (TaskyColors.verde). -->
            <KeyedObject objectId="0:92">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="4D76C42B" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:93">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="0076C42B" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:94">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="3B76C42B" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:95">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="1C76C42B" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:96">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="0076C42B" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <LinearAnimation duration="1" name="DesanimadoNao" id="0:76">
            <KeyedObject objectId="0:38">
                <KeyedProperty property="opacity">
                    <KeyFrameDouble value="0" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <LinearAnimation duration="1" name="DesanimadoSim" id="0:77">
            <KeyedObject objectId="0:38">
                <KeyedProperty property="opacity">
                    <KeyFrameDouble value="1" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <!-- Rabo um pouco recolhido, menos que no mood 0. Mexer no mesmo
                 no que o mood 0 usa e seguro: as faixas nao se sobrepoem. -->
            <KeyedObject objectId="0:47">
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="0.12" interpolationType="hold"/>
                </KeyedProperty>
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble value="0.85" interpolationType="hold"/>
                </KeyedProperty>
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="0.85" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <!-- Aura laranja (TaskyColors.laranja). -->
            <KeyedObject objectId="0:92">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="4DF39A16" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:93">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="00F39A16" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:94">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="3BF39A16" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:95">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="1CF39A16" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:96">
                <KeyedProperty property="colorValue">
                    <KeyFrameColor value="00F39A16" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Estado de repouso da camada "reacao": nao mexe em nada. -->
        <LinearAnimation duration="1" name="Parado" id="0:72"/>
    </Artboard>

    <ImageAsset file="cabeca.png" name="cabeca" id="0:60"/>
    <!-- O antigo corpo.png continua na pasta, mas nao e mais declarado:
         foi substituido por tronco.png + pernas.png. Arquivo nao declarado
         nao entra no .riv. -->
    <ImageAsset file="tronco.png" name="tronco" id="0:61"/>
    <ImageAsset file="pernas.png" name="pernas" id="0:80"/>
    <ImageAsset file="cauda.png" name="cauda" id="0:62"/>
    <ImageAsset file="olho_dir.png" name="olho_dir" id="0:63"/>
    <ImageAsset file="olho_esq.png" name="olho_esq" id="0:64"/>
    <ImageAsset file="rosto_muito_desanimado.png" name="rosto_muito_desanimado" id="0:65"/>
    <ImageAsset file="rosto_desanimado.png" name="rosto_desanimado" id="0:66"/>
    <ImageAsset file="rosto_alegre.png" name="rosto_alegre" id="0:68"/>

    <!-- Rampa de postura comum a todos os humores. O extra do mood 0 vem da
         camada dele, nao daqui. -->
    <DataConverterRangeMapper minInput="0" maxInput="4" minOutput="14" maxOutput="0"
                              clampLower="true" clampUpper="true"
                              name="moodParaCurvatura" id="0:50"/>
    <DataConverterRangeMapper minInput="0" maxInput="4" minOutput="0.09" maxOutput="-0.03"
                              clampLower="true" clampUpper="true"
                              name="moodParaCabeca" id="0:51"/>
    <DataConverterRangeMapper minInput="0" maxInput="4" minOutput="0.3" maxOutput="-0.24"
                              clampLower="true" clampUpper="true"
                              name="moodParaCauda" id="0:52"/>

    <ViewModel defaultInstanceId="0:41" name="Tasky" id="0:40">
        <ViewModelPropertyNumber name="mood" id="0:45"/>
        <ViewModelPropertyTrigger name="tap" id="0:46"/>
        <ViewModelInstance exports="true" name="Default" id="0:41">
            <ViewModelInstanceNumber propertyValue="2" viewModelPropertyId="0:45"/>
            <ViewModelInstanceTrigger viewModelPropertyId="0:46"/>
        </ViewModelInstance>
    </ViewModel>
</Rive>
