                        <TransitionViewModelCondition opValue="lessThan">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyNumber>
                                    <DataBindContext sourcePathIds="0:40-0:45" propertyKey="636"/>
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="2.5"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>

                <AnimationState x="420" y="20" animationId="0:97" id="0:101">
                    <StateTransition stateToId="0:100" duration="0">
                        <TransitionViewModelCondition opValue="lessThan">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyNumber>
                                    <DataBindContext sourcePathIds="0:40-0:45" propertyKey="636"/>
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="1.5"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="0:100" duration="0">
                        <TransitionViewModelCondition opValue="greaterThanOrEqual">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyNumber>
                                    <DataBindContext sourcePathIds="0:40-0:45" propertyKey="636"/>
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="2.5"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>

            <!-- Topo da escala: so a aura, sem faixa superior (mood maximo e 4). -->
            <StateMachineLayer name="semblante-muito-alegre" id="0:88">
                <AnyState x="220" y="-120"/>
                <ExitState x="420" y="-120"/>
                <EntryState x="20" y="20">
                    <StateTransition stateToId="0:89"/>
                </EntryState>

                <AnimationState x="220" y="20" animationId="0:86" id="0:89">
                    <StateTransition stateToId="0:90" duration="0">
                        <TransitionViewModelCondition opValue="greaterThanOrEqual">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyNumber>
                                    <DataBindContext sourcePathIds="0:40-0:45" propertyKey="636"/>
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="3.5"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>

                <AnimationState x="420" y="20" animationId="0:87" id="0:90">
                    <StateTransition stateToId="0:89" duration="0">
                        <TransitionViewModelCondition opValue="lessThan">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyNumber>
                                    <DataBindContext sourcePathIds="0:40-0:45" propertyKey="636"/>
